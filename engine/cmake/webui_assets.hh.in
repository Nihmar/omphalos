#pragma once

#include <cstddef>
#include <span>
#include <string_view>

namespace omph::server::webui {

struct Asset {
    std::string_view name;  // the route, relative to the server root
    const unsigned char * data;
    std::size_t size;
    std::string_view etag;  // hex SHA-256 of the embedded bytes
    std::string_view type;  // the Content-Type
