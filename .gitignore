# Build directories (CMake)
build/
build-*/
cmake-build-*/

# Model files and converted weights — local only (PLAN.md)
models/
*.gguf

# Python tooling (managed via uv)
.venv/
__pycache__/
*.py[cod]

# Command Code local session data
.commandcode/

# Editor and OS files
.vscode/
.idea/
*.swp
*~

# Benchmark scratch (llama-server run logs; result CSVs are tracked)
bench/results/*.srv.log

# Raw profiler traces (summaries are kept in bench/results/)
bench/traces/

# Native tool binaries (built by tools/native/build.sh)
tools/native/dump_tensors
tools/native/isa_probe
tools/native/dump_mtmd_logits

# rocprofv3 output
.rocprofv3/

# Tool outputs the AGENTS.md commands write into the working directory
# (logits, dequant dumps, llama.cpp KL bases, cached references). None are
# tracked; a fixture that must be would need an explicit `!path` here.
*.f32
*.raw
*.kld
*.npz
